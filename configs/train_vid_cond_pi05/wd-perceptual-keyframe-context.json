{
  "checkpoint_dir": "${OPENPI_DATA_HOME}/openpi-assets/checkpoints/pi05_base",
  "data_dir": "${ROBOREEL_DATA}",
  "demonstration_config": "perceptual-keyframe-context.yaml",
  "use_demonstration": true,
  "output_dir": "${ROBOREEL_CKPT}/wd/pi05_video_perceptual_context_bpp",
  "demo_cameras": ["front"],
  "robot_cameras": ["base_camera", "hand_camera"],
  "prompt": "complete the task",
  "batch_size": 64,
  "num_train_steps": 50000,
  "peak_lr": 5e-5,
  "warmup_steps": 1000,
  "ema_decay": 0.999,
  "grad_clip": 1.0,
  "seed": 42,
  "fsdp_devices": 1,
  "lfo_max_demo_index": 79,
  "include_video_types": ["with_distraction"],
  "keyframe_annotation_dir": "${ROBOREEL_DATA}/bpp_keyframe_annotations",
  "log_interval": 50,
  "save_interval": 10000,
  "wandb": false
}
